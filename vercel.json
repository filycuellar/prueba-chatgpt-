{
  "framework": "jekyll",
  "installCommand": "bundle install",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://filycuellar.github.io/prueba_maribel/admin/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://filycuellar.github.io/prueba_maribel/admin/:path*",
      "permanent": false
    }
  ]
}
